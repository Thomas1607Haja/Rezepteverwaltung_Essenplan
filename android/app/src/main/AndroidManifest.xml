<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      allowBackup/dataExtractionRules: Der API-Schlüssel und die lokale
      Datenbank sollen nicht in Google- oder Geräte-Backups landen; nach einer
      Neuinstallation wird die App per QR-Code neu eingerichtet.
      enableOnBackInvokedCallback: vorausschauende Zurück-Geste (Android 13+,
      ab Zielversion 36 ohnehin Standard).
    -->
    <!-- Zugriff auf den Rezeptplaner. Eine Kamera-Berechtigung braucht es
         nicht: Den QR-Code liest der Scanner der Google Play-Dienste. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Knopf „Akku-Optimierung ausschalten“: Samsung hält sonst den Abgleich
         im Hintergrund an (siehe ui/settings/SyncCard.kt). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".RezeptplanerApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Rezeptplaner"
        tools:ignore="DataExtractionRules"
        tools:targetApi="33">

        <!-- Scanner-Modul der Play-Dienste schon bei der Installation laden,
             nicht erst beim ersten Scan. -->
        <!-- Fotos der Kamera-App für das Rezeptbild (res/xml/file_paths.xml). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui,ocr" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- QR-Code zum Verbinden (rezeptplaner://setup?url=…&key=…), z. B.
                 mit der Kamera-App gescannt. Die App fragt vor dem Speichern nach. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="rezeptplaner" android:host="setup" />
            </intent-filter>
            <!-- Datei-Import (docs/PLANUNG.md, 7.6b): „Öffnen mit“ aus WhatsApp,
                 „Eigene Dateien“, Downloads. WhatsApp und andere geben oft den
                 allgemeinen Typ application/octet-stream an; die App prüft den
                 Inhalt. Bewusst nicht */*, sonst stünde sie bei jedem Foto. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <!-- Teilen: eine oder mehrere Dateien. text/plain für .json, die
                 manche Apps als Text weitergeben (und später Rezept-URLs). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
